{
  "name": "solarispkn-transport",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs scripts/sofse_api.test.mjs",
    "test:python": "python -m unittest discover -s tests -v",
    "live:build": "node scripts/build-live-worker.mjs",
    "live:env": "node scripts/resolve-live-environment.mjs",
    "live:check": "npm run live:build && npx wrangler deploy --dry-run --config .live-build/wrangler.jsonc",
    "live:deploy": "npm run live:build && npx wrangler deploy --config .live-build/wrangler.jsonc",
    "live:archive": "node scripts/archive-live-history.mjs",
    "validate": "npm run test && npm run test:python && npm run live:build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "gtfs-realtime-bindings": "^1.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "wrangler": "^4.34.0"
  }
}
