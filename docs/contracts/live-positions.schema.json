{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-positions.schema.json",
  "title": "SolarisPKN consolidated live positions snapshot",
  "description": "Provider-neutral contract for a short-lived consolidated snapshot. Timetables are referenced only as a fallback and are never represented as live positions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "expiresAt",
    "discardAfter",
    "status",
    "sources",
    "vehicles",
    "fallback"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "discardAfter": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "degraded", "unavailable"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "vehicles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vehicle"
      }
    },
    "fallback": {
      "$ref": "#/$defs/fallback"
    }
  },
  "$defs": {
    "nullableDateTime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "lastAttemptAt",
        "lastSuccessfulAt",
        "vehicleCount",
        "errorCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "status": {
          "type": "string",
          "enum": ["ok", "degraded", "unavailable", "disabled"]
        },
        "lastAttemptAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "lastSuccessfulAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "vehicleCount": {
          "type": "integer",
          "minimum": 0
        },
        "errorCode": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "bearing": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "accuracyMeters": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "vehicleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recordId"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "recordId": {
          "$ref": "#/$defs/nullableIdentifier"
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "provider",
        "operator",
        "routeId",
        "tripId",
        "direction",
        "label",
        "status",
        "positionKind",
        "position",
        "observedAt",
        "receivedAt",
        "dataStatus",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:._-]{2,199}$"
        },
        "mode": {
          "type": "string",
          "enum": ["train", "bus"]
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "operator": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "routeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tripId": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "direction": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "unknown"]
        },
        "positionKind": {
          "type": "string",
          "enum": ["reported", "estimated", "none"]
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "dataStatus": {
          "type": "string",
          "enum": ["fresh", "stale"]
        },
        "source": {
          "$ref": "#/$defs/vehicleSource"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "positionKind": {
                "enum": ["reported", "estimated"]
              }
            },
            "required": ["positionKind"]
          },
          "then": {
            "properties": {
              "position": {
                "$ref": "#/$defs/position"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "positionKind": {
                "const": "none"
              }
            },
            "required": ["positionKind"]
          },
          "then": {
            "properties": {
              "position": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "positionKind": {
                "const": "reported"
              }
            },
            "required": ["positionKind"]
          },
          "then": {
            "properties": {
              "observedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason", "timetableRef"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "timetable-only"]
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["live-unavailable", "live-expired", "semantic-invalid-response"]
            },
            {
              "type": "null"
            }
          ]
        },
        "timetableRef": {
          "$ref": "#/$defs/nullableIdentifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "timetableRef": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "timetable-only"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              },
              "timetableRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
